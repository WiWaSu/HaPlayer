<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HaPlayer.ViewModels"
        xmlns:ui="using:HaPlayer.Ui">

  <Styles.Resources>
    <!-- Палитра бренда (assets/branding): чёрный, неоновый пурпурный, кислотно-жёлтый. -->
    <Color x:Key="AccentColor">#FF2BD6</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#000000" />
    <SolidColorBrush x:Key="PanelBrush" Color="#121212" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6A6A6A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2BD6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF5CE1" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#E6FF00" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1AFFFFFF" />

    <LinearGradientBrush x:Key="LikedBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#FF2BD6" Offset="0" />
      <GradientStop Color="#4B1FA8" Offset="1" />
    </LinearGradientBrush>

    <!-- Ползунки Fluent: тонкая дорожка, белая заливка, акцент при наведении. -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="#4D4D4D" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#4D4D4D" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#4D4D4D" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF2BD6" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF2BD6" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF" />
    <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
    <x:Double x:Key="SliderVerticalThumbWidth">12</x:Double>
    <x:Double x:Key="SliderVerticalThumbHeight">12</x:Double>
    <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>

    <!-- Меню по правому клику и выпадающие меню: тёмная карточка, как в Spotify -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#282828" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#14FFFFFF" />
    <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#3E3E3E" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#3E3E3E" />
    <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundPointerOver" Color="#3E3E3E" />
    <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="#3E3E3E" />
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#E6E6E6" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#1AFFFFFF" />

    <!-- Подсказки -->
    <SolidColorBrush x:Key="ToolTipBackground" Color="#282828" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="Transparent" />

    <!-- Выпадающий список -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#333333" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#333333" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#4D4D4D" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#4D4D4D" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#282828" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#3E3E3E" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#333333" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#3E3E3E" />

    <!-- Полосы прокрутки: тонкие и светлые, как у Spotify -->
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#B3FFFFFF" />

    <!-- Поле поиска -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#242424" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2A2A2A" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4D4D4D" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A8A8A" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8A8A8A" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FF2BD6" />

    <!-- Строка таблицы треков. Общая для всех списков: «Все треки», поиск, альбом, исполнитель, плейлист. -->
    <DataTemplate x:Key="TrackRowTemplate" x:DataType="vm:TrackRow">
      <Grid ColumnDefinitions="40,5*,3*,120,120" Height="56" Background="Transparent">
        <!-- Номер. При наведении вместо него кнопка «играть», у играющего трека полоски эквалайзера. -->
        <Panel Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="24">
          <TextBlock Classes="num" Classes.current="{Binding Item.IsCurrent}" HorizontalAlignment="Right"
                     Text="{Binding Number}" IsVisible="{Binding !Item.IsPlaying}" />
          <StackPanel Classes="eqbars" Orientation="Horizontal" Spacing="2" Height="14" HorizontalAlignment="Right"
                      IsVisible="{Binding Item.IsPlaying}">
            <Rectangle Classes="eq eq1" />
            <Rectangle Classes="eq eq2" />
            <Rectangle Classes="eq eq3" />
          </StackPanel>
          <Button Classes="rowplay" Command="{Binding ToggleCommand}" HorizontalAlignment="Right">
            <Panel>
              <ui:Glyph Data="{x:Static ui:Icons.Play}" Width="18" Height="18" IsVisible="{Binding !Item.IsPlaying}" />
              <ui:Glyph Data="{x:Static ui:Icons.Pause}" Width="18" Height="18" IsVisible="{Binding Item.IsPlaying}" />
            </Panel>
          </Button>
        </Panel>

        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="16,0,8,0" VerticalAlignment="Center">
          <ui:CoverView Width="40" Height="40" Margin="0,0,12,0"
                        Source="{Binding Item.Album.Thumb}" IsVisible="{Binding ShowCover}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock Classes="rowtitle" Classes.current="{Binding Item.IsCurrent}" Text="{Binding Item.Title}" />
            <TextBlock Classes="rowsub" Text="{Binding Item.Artist}" />
          </StackPanel>
        </Grid>

        <TextBlock Grid.Column="2" Classes="rowsub" VerticalAlignment="Center" Margin="0,0,12,0"
                   Text="{Binding Secondary}" />
        <TextBlock Grid.Column="3" Classes="rowsub" VerticalAlignment="Center" Margin="0,0,12,0"
                   Text="{Binding Item.AddedText}" />

        <!-- Как у Spotify: в любимых закрашенный кружок с галочкой, иначе кружок с плюсом при наведении -->
        <Grid Grid.Column="4" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,16,0">
          <Button Classes="heart" Classes.liked="{Binding Item.IsLiked}" Command="{Binding LikeCommand}"
                  HorizontalAlignment="Right" Margin="0,0,18,0" ToolTip.Tip="Любимые треки (L)">
            <Panel Width="17" Height="17">
              <ui:Glyph Data="{x:Static ui:Icons.CirclePlus}" IsVisible="{Binding !Item.IsLiked}" />
              <Panel IsVisible="{Binding Item.IsLiked}">
                <ui:Glyph Data="{x:Static ui:Icons.CircleFill}" Foreground="{DynamicResource AccentBrush}" />
                <ui:Glyph Data="{x:Static ui:Icons.Check}" Foreground="Black" StrokeThickness="3" />
              </Panel>
            </Panel>
          </Button>
          <TextBlock Grid.Column="1" Classes="rowsub" VerticalAlignment="Center" Text="{Binding Item.DurationText}" />
        </Grid>
      </Grid>
    </DataTemplate>
  </Styles.Resources>

  <!-- Текст -->

  <Style Selector="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.sub">
    <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.hero">
    <Setter Property="FontSize" Value="76" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="LetterSpacing" Value="-2.5" />
    <Setter Property="Margin" Value="0,4,0,12" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>
  <Style Selector="TextBlock.num">
    <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="TextBlock.rowtitle">
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="TextBlock.rowsub">
    <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.current">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Анимированный эквалайзер у играющего трека -->
  <Style Selector="Rectangle.eq">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="3" />
    <Setter Property="RadiusX" Value="1" />
    <Setter Property="RadiusY" Value="1" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Fill" Value="{DynamicResource HighlightBrush}" />
  </Style>
  <Style Selector="Rectangle.eq1">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Height" Value="3" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Height" Value="14" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Height" Value="3" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Rectangle.eq2">
    <Style.Animations>
      <Animation Duration="0:0:0.7" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Height" Value="12" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Height" Value="4" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Height" Value="12" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Rectangle.eq3">
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Height" Value="7" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Height" Value="13" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Height" Value="7" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Панели -->

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- Кнопки: общая плавность для всех -->

  <Style Selector="Button">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Круглая кнопка-иконка: перемешать, повтор, назад, вперёд, громкость -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.icon:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.06)" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#4D4D4D" />
  </Style>
  <Style Selector="Button.icon.on">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.icon.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <!-- Точка под включённой кнопкой, как у перемешивания и повтора в Spotify -->
  <Style Selector="Button.icon.dot.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Padding" Value="0,0,0,2" />
  </Style>
  <Style Selector="Button.icon.hoverbg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <!-- Круглая кнопка с подложкой: «+» у медиатеки, «…» на страницах -->
  <Style Selector="Button.icon.round">
    <Setter Property="Background" Value="#1FFFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
  </Style>
  <Style Selector="Button.icon.round:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.icon.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon.large">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="24" />
  </Style>

  <!-- Белая круглая кнопка «играть» в нижней панели -->
  <Style Selector="Button.play">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.play:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.07)" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button.play:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#DDDDDD" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button.play.big">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="64" />
    <Setter Property="CornerRadius" Value="32" />
  </Style>

  <!-- Большая акцентная кнопка «играть» на страницах и плавающая на карточках -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.05)" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#5A2A52" />
    <Setter Property="Foreground" Value="#80000000" />
  </Style>
  <Style Selector="Button.primary.small">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="Button.primary.float">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translateY(8px)" />
  </Style>
  <Style Selector="Button.card:pointerover Button.primary.float, Button.quick:pointerover Button.primary.float">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Button.card:pointerover Button.primary.float:pointerover, Button.quick:pointerover Button.primary.float:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.06)" />
  </Style>

  <!-- Кнопка «играть» в строке трека и сердечко: видны при наведении на строку -->
  <Style Selector="Button.rowplay, Button.heart">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.rowplay">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.heart">
    <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
  </Style>
  <Style Selector="Button.heart.liked">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.rowplay:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.heart:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.rowplay:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.heart:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.heart:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.heart.liked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover Button.rowplay, ListBoxItem:pointerover Button.heart">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ListBoxItem:pointerover TextBlock.num, ListBoxItem:pointerover StackPanel.eqbars">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ListBoxItem:pointerover TextBlock.rowsub">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- Большое сердечко в нижней панели и на экране «Сейчас играет» -->
  <Style Selector="Button.icon.like.on">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Пункты навигации слева -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- Вкладки в боковой панели: Плейлисты / Альбомы / Исполнители -->
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="11,6" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3A3A3A" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.chip.active">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button.chip.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="Black" />
  </Style>

  <!-- Белая «таблетка» и прозрачная с рамкой -->
  <Style Selector="Button.pill">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.pill:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.04)" />
  </Style>
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button.pill.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.pill.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="White" />
  </Style>

  <!-- Карточка альбома или исполнителя -->
  <Style Selector="Button.card">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Width" Value="188" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
  </Style>
  <Style Selector="Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <Style Selector="Button.card:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- Плитка быстрого доступа на главной -->
  <Style Selector="Button.quick">
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="64" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.quick:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2EFFFFFF" />
  </Style>
  <Style Selector="Button.quick:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#24FFFFFF" />
  </Style>
  <Style Selector="Button.quick:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- «Сейчас играет» в нижней панели: обложка и название кликабельны -->
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.flat:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Button.flat:pointerover TextBlock.link">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <!-- Списки -->

  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem">
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.tracks ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1AFFFFFF" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#26FFFFFF" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33FFFFFF" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#40FFFFFF" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#40FFFFFF" />
  </Style>

  <!-- Поле поиска -->
  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="48,0,16,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Ползунки -->

  <Style Selector="Slider">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Slider:vertical">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="20" />
  </Style>

  <!-- Значки на светлых и акцентных кнопках: чёрные, как у Spotify. PathIcon сам цвет кнопки не наследует. -->
  <Style Selector="Button.primary ui|Glyph, Button.play ui|Glyph, Button.pill ui|Glyph, Button.chip.active ui|Glyph">
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button.pill.ghost ui|Glyph">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Меню и подсказки: скругления и отступы -->
  <Style Selector="ContextMenu, MenuFlyoutPresenter">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="220" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <!-- Переключатель эквалайзера -->
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
  </Style>
  <!-- Раскладка как у Spotify: верхняя панель, медиатека, нижняя панель -->

  <!-- Круглая кнопка «Домой» и «Настройки» в верхней панели -->
  <Style Selector="Button.topround">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Background" Value="#1F1F1F" />
    <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.topround.small">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="Button.topround:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.04)" />
  </Style>
  <Style Selector="Button.topround:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2A2A2A" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.topround:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1F1F1F" />
  </Style>
  <Style Selector="Button.topround.active">
    <Setter Property="Background" Value="#333333" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.topround.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3E3E3E" />
  </Style>

  <!-- «Назад» и «Вперёд» -->
  <Style Selector="Button.icon.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="#4D4D4D" />
  </Style>

  <!-- Поле поиска наверху: «Что хочешь включить?» -->
  <Style Selector="TextBox.topsearch">
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="50,0,20,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Background" Value="#1F1F1F" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.topsearch:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#2A2A2A" />
    <Setter Property="BorderBrush" Value="#333333" />
  </Style>
  <Style Selector="TextBox.topsearch:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#2A2A2A" />
    <Setter Property="BorderBrush" Value="White" />
  </Style>

  <!-- Поиск внутри медиатеки -->
  <Style Selector="TextBox.inline">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="#2A2A2A" />
  </Style>

  <!-- Тёмная таблетка: «+ Создать», «+ Добавить», «Название и сведения» -->
  <Style Selector="Button.pill.dark">
    <Setter Property="Background" Value="#1F1F1F" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.pill.dark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2A2A2A" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.pill.dark ui|Glyph">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Сортировка «Недавние» -->
  <Style Selector="Button.flat.sort">
    <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="Button.flat.sort:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- Чипы-фильтры -->
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="#2A2A2A" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Button.chip.round">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chip ui|Glyph">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Строки медиатеки -->
  <Style Selector="TextBlock.libname">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.libname.playing">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.libsub">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
  </Style>
  <Style Selector="ListBox.library ListBoxItem">
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- Строка-кнопка в правой панели -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2A2A2A" />
  </Style>
  <Style Selector="Button.row:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <!-- Включённый чип: белый. Стоит последним, потому что в Avalonia побеждает последний подходящий стиль. -->
  <Style Selector="Button.chip.active">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="Button.chip.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F0F0F0" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <!-- Серые полоски-заглушки в пустой истории -->
  <Style Selector="Border.skel">
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="#2A2A2A" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- Пункт меню, который удаляет -->
  <Style Selector="MenuItem.danger">
    <Setter Property="Foreground" Value="#FF7A7A" />
  </Style>
</Styles>