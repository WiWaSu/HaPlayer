<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HaPlayer.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <!-- Акцент бренда для стандартных элементов: переключатели, выделение, фокус -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FF2BD6" RegionColor="#121212" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://HaPlayer/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
