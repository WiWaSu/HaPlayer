<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HaPlayer.ViewModels"
        xmlns:v="using:HaPlayer.Views"
        xmlns:ui="using:HaPlayer.Ui"
        x:Class="HaPlayer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="HaPlayer"
        Icon="avares://HaPlayer/Assets/haplayer.ico"
        Width="1440" Height="900" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"

        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="64"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <!-- Выезжающий снизу экран. Закрытый остаётся в дереве, но прозрачен и не ловит мышь:
         так работает анимация и в обратную сторону. -->
    <Style Selector="v|NowPlayingView.sheet">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderTransform" Value="translateY(120px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="v|NowPlayingView.sheet.open">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>

    <!-- Карточки выбора вида при первом запуске -->
    <Style Selector="Button.viewcard">
      <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="CornerRadius" Value="{DynamicResource R12}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.viewcard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="v|EqualizerView.pop">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderTransform" Value="translateY(16px) scale(0.98)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="v|EqualizerView.pop.open">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <DataTemplate DataType="vm:HomePageViewModel"><v:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:SearchPageViewModel"><v:SearchView /></DataTemplate>
    <DataTemplate DataType="vm:TracksPageViewModel"><v:TracksView /></DataTemplate>
    <DataTemplate DataType="vm:CollectionPageViewModel"><v:CollectionView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsPageViewModel"><v:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:StatsPageViewModel"><v:StatsView /></DataTemplate>
    <DataTemplate DataType="vm:YearsPageViewModel"><v:YearsView /></DataTemplate>
  </Window.DataTemplates>

  <Panel>
  <!-- Своя картинка на фоне окна и затемнение поверх неё -->
  <Image x:Name="BgImage" Stretch="UniformToFill" IsVisible="False" IsHitTestVisible="False" />
  <Border x:Name="BgDim" Background="Black" IsVisible="False" IsHitTestVisible="False" />
  <LayoutTransformControl x:Name="Scaler">
  <Panel>
    <Grid x:Name="Root" RowDefinitions="64,*,80" ColumnDefinitions="370,*,Auto" Margin="8,0" IsVisible="{Binding IsModern}">

      <!-- Верхняя панель, как в Spotify. Пустые места не ловят мышь: за них окно перетаскивается. -->
      <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="4,0,0,0">
          <Image Source="avares://HaPlayer/Assets/logo-64.png" Width="28" Height="28" Margin="0,0,10,0"
                 IsHitTestVisible="False" />
          <Button Classes="icon nav" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}"
                  ToolTip.Tip="{ui:T 'Назад'}">
            <ui:Glyph Data="{x:Static ui:Icons.ChevronLeft}" Width="22" Height="22" />
          </Button>
          <Button Classes="icon nav" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}"
                  ToolTip.Tip="{ui:T 'Вперёд'}">
            <ui:Glyph Data="{x:Static ui:Icons.ChevronRight}" Width="22" Height="22" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="topround" Classes.active="{Binding IsHomeActive}" Command="{Binding GoHomeCommand}"
                  ToolTip.Tip="{ui:T 'Главная'}">
            <ui:Glyph Data="{x:Static ui:Icons.Home}" Width="22" Height="22" />
          </Button>
          <Panel x:Name="TopSearchBox" Width="470">
            <TextBox x:Name="TopSearch" Classes="topsearch" Text="{Binding SearchQuery}"
                     Watermark="{ui:T 'Что хочешь включить?'}" />
            <ui:Glyph Data="{x:Static ui:Icons.Search}" Width="22" Height="22" Foreground="{DynamicResource SubBrush}"
                      HorizontalAlignment="Left" Margin="16,0,0,0" IsHitTestVisible="False" />
          </Panel>
        </StackPanel>

        <!-- Справа отступ под системные кнопки окна -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,150,0">
          <Button Classes="pill" IsVisible="{Binding HasUpdate}" Command="{Binding InstallUpdateCommand}" Margin="0,0,10,0"
                  VerticalAlignment="Center" ToolTip.Tip="{ui:T 'Обновить HaPlayer'}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Glyph Data="{x:Static ui:Icons.Import}" Width="16" Height="16" />
              <TextBlock Text="{Binding UpdateText}" />
            </StackPanel>
          </Button>
          <Button Classes="topround small" Classes.active="{Binding IsStatsActive}" Command="{Binding GoStatsCommand}"
                  ToolTip.Tip="{ui:T 'Итоги'}" Margin="0,0,8,0">
            <ui:Glyph Data="{x:Static ui:Icons.Stats}" Width="20" Height="20" />
          </Button>
          <Button Classes="topround small" Classes.active="{Binding IsHistoryPanelOpen}" Command="{Binding ToggleHistoryPanelCommand}"
                  ToolTip.Tip="{ui:T 'История прослушивания'}" Margin="0,0,8,0">
            <ui:Glyph Data="{x:Static ui:Icons.History}" Width="20" Height="20" />
          </Button>
          <Button Classes="topround small" Classes.active="{Binding IsSettingsActive}" Command="{Binding GoSettingsCommand}"
                  ToolTip.Tip="{Binding SettingsTip}">
            <ui:Glyph Data="{x:Static ui:Icons.Settings}" Width="20" Height="20" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Развёрнутая медиатека занимает и колонку страницы -->
      <v:SidebarView x:Name="Sidebar" Grid.Row="1" Grid.ColumnSpan="{Binding LibrarySpan}" Margin="0,0,8,8" />

      <Border Grid.Row="1" Grid.Column="1" Classes="panel" ClipToBounds="True" Margin="0,0,0,8"
              IsVisible="{Binding !IsLibraryExpanded}">
        <Panel>
          <ContentControl Content="{Binding CurrentPage}" />
          <!-- Хлебные крошки: где мы находимся. Поверх шапки страницы, в левом верхнем углу. -->
          <Border Classes="crumbs" IsVisible="{Binding HasCrumbs}">
            <ItemsControl ItemsSource="{Binding Crumbs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:Crumb">
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="flat crumb" Command="{Binding GoCommand}" IsVisible="{Binding IsLink}">
                      <TextBlock Classes="link" Text="{Binding Title}" MaxWidth="220" />
                    </Button>
                    <TextBlock Text="›" Classes="crumbsep" IsVisible="{Binding IsLink}" />
                    <TextBlock Text="{Binding Title}" Classes="crumbnow" IsVisible="{Binding IsCurrent}" MaxWidth="320" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </Panel>
      </Border>

      <!-- Правая панель: одна из трёх -->
      <!-- На узком окне правая панель прячется целиком, её место нужнее списку -->
      <Panel x:Name="RightPanels" Grid.Row="1" Grid.Column="2">
        <v:QueuePanelView Width="340" Margin="8,0,0,8" IsVisible="{Binding ShowQueuePanel}" />
        <v:DevicesPanelView Width="340" Margin="8,0,0,8" IsVisible="{Binding ShowDevicesPanel}" />
        <v:HistoryPanelView Width="340" Margin="8,0,0,8" IsVisible="{Binding ShowHistoryPanel}" />
      </Panel>

      <v:PlayerBarView Grid.Row="2" Grid.ColumnSpan="3" />

      <!-- «Сейчас играет» на весь экран: выезжает снизу из нижней панели, как в Spotify -->
      <v:NowPlayingView Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="3" Margin="-8,0,-8,0"
                        Classes="sheet" Classes.open="{Binding IsNowPlayingOpen}" />

    </Grid>

    <!-- Классический вид: та же медиатека, раскладка как у настольных плееров -->
    <v:ClassicView x:Name="Classic" IsVisible="{Binding IsClassic}" />

      <!-- Палитра команд (Ctrl+K) -->
      <Panel IsVisible="{Binding Palette.IsOpen}">
        <Border Background="#80000000" PointerPressed="OnPaletteBackdrop" />
        <Border Classes="palette" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,90,0,0" Width="600">
          <DockPanel>
            <Panel DockPanel.Dock="Top">
              <TextBox x:Name="PaletteBox" Classes="topsearch" Text="{Binding Palette.Query}"
                       Watermark="{ui:T 'Трек, альбом, исполнитель или команда'}" />
              <ui:Glyph Data="{x:Static ui:Icons.Search}" Width="20" Height="20" Foreground="{DynamicResource SubBrush}"
                        HorizontalAlignment="Left" Margin="16,0,0,0" IsHitTestVisible="False" />
            </Panel>
            <ListBox Classes="plain" ItemsSource="{Binding Palette.Results}" SelectedIndex="{Binding Palette.SelectedIndex}"
                     MaxHeight="420" Margin="0,8,0,0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PaletteItem">
                  <Grid ColumnDefinitions="36,*,Auto" Height="40" Background="Transparent" Tapped="OnPaletteItemTapped">
                    <ui:Glyph Data="{Binding Icon}" Width="18" Height="18" Foreground="{DynamicResource SubBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Sub}" Classes="sub" FontSize="12" VerticalAlignment="Center"
                               MaxWidth="220" Margin="12,0,8,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Panel>

      <!-- Эквалайзер: карточка над нижней панелью справа -->
      <v:EqualizerView HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,16,96" Classes="pop" Classes.open="{Binding IsEqualizerOpen}" />

    <!-- Подсказка при перетаскивании файлов -->
    <Border x:Name="DropOverlay" IsVisible="False" Background="#B3000000" IsHitTestVisible="False">
      <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="16"
              Padding="64,48" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{ui:T 'Отпустите, чтобы добавить музыку'}" FontSize="20" FontWeight="Bold" />
      </Border>
    </Border>

    <!-- Индикатор сканирования -->
    <Border IsVisible="{Binding IsBusy}" Background="{DynamicResource InverseBrush}" CornerRadius="{DynamicResource R8}" Padding="18,10"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,100"
            BoxShadow="0 8 24 0 #80000000">
      <TextBlock Text="{Binding BusyText}" Foreground="{DynamicResource InverseTextBrush}" FontWeight="SemiBold" />
    </Border>

    <!-- Первый запуск: выбор вида -->
    <Border IsVisible="{Binding IsViewChooserOpen}" Background="{DynamicResource BgBrush}">
      <ScrollViewer>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="28" Margin="24,64,24,24">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <TextBlock Text="{ui:T 'Как будет выглядеть HaPlayer?'}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                     TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock Text="{ui:T 'Поменять можно в любой момент: «Настройки → Оформление → Вид».'}" Foreground="{DynamicResource SubBrush}"
                     HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
        <WrapPanel HorizontalAlignment="Center">
          <Button Classes="viewcard" Command="{Binding ChooseViewCommand}" CommandParameter="modern" Margin="10">
            <StackPanel Spacing="14" Width="340">
              <!-- Схема современного вида: медиатека слева, крупные карточки, панель снизу -->
              <Border Height="200" CornerRadius="{DynamicResource R8}" Background="{DynamicResource BgBrush}" Padding="8">
                <Grid ColumnDefinitions="70,*" RowDefinitions="*,28">
                  <Border Background="{DynamicResource PanelBrush}" CornerRadius="{DynamicResource R6}" Margin="0,0,6,6">
                    <StackPanel Margin="6" Spacing="6">
                      <Border Height="16" CornerRadius="3" Background="{DynamicResource AccentBrush}" Opacity="0.85" />
                      <Border Height="16" CornerRadius="3" Background="{DynamicResource RaisedBrush}" />
                      <Border Height="16" CornerRadius="3" Background="{DynamicResource RaisedBrush}" />
                      <Border Height="16" CornerRadius="3" Background="{DynamicResource RaisedBrush}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="{DynamicResource R6}" Margin="0,0,0,6">
                    <UniformGrid Columns="3" Margin="8">
                      <Border Margin="4" CornerRadius="4" Background="{DynamicResource AccentBrush}" Opacity="0.7" />
                      <Border Margin="4" CornerRadius="4" Background="{DynamicResource RaisedBrush}" />
                      <Border Margin="4" CornerRadius="4" Background="{DynamicResource RaisedBrush}" />
                      <Border Margin="4" CornerRadius="4" Background="{DynamicResource RaisedBrush}" />
                      <Border Margin="4" CornerRadius="4" Background="{DynamicResource AccentBrush}" Opacity="0.4" />
                      <Border Margin="4" CornerRadius="4" Background="{DynamicResource RaisedBrush}" />
                    </UniformGrid>
                  </Border>
                  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource PanelBrush}" CornerRadius="{DynamicResource R6}">
                    <Ellipse Width="14" Height="14" Fill="{DynamicResource TextBrush}" />
                  </Border>
                </Grid>
              </Border>
              <StackPanel Spacing="4">
                <TextBlock Text="{ui:T 'Современный'}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{ui:T 'Крупные обложки, главная с подборками, просторные страницы альбомов и исполнителей.'}"
                           Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Classes="viewcard" Command="{Binding ChooseViewCommand}" CommandParameter="classic" Margin="10">
            <StackPanel Spacing="14" Width="340">
              <!-- Схема классического вида: панель со временем сверху, дерево слева, таблица -->
              <Border Height="200" CornerRadius="{DynamicResource R8}" Background="{DynamicResource BgBrush}" Padding="8">
                <Grid ColumnDefinitions="80,*" RowDefinitions="44,*">
                  <Border Grid.ColumnSpan="2" Background="{DynamicResource PanelBrush}" CornerRadius="{DynamicResource R6}" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="6">
                      <Border Width="26" Height="26" CornerRadius="3" Background="{DynamicResource AccentBrush}" Opacity="0.8" />
                      <StackPanel Grid.Column="1" Margin="8,2" Spacing="5">
                        <Border Height="7" Width="90" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource TextBrush}" Opacity="0.8" />
                        <Border Height="5" Width="60" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource SubBrush}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="1:24" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="{DynamicResource R6}" Margin="0,0,6,0">
                    <StackPanel Margin="6" Spacing="5">
                      <Border Height="6" Width="50" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource SubBrush}" />
                      <Border Height="6" Width="40" Margin="8,0,0,0" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource MutedBrush}" />
                      <Border Height="6" Width="44" Margin="8,0,0,0" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource MutedBrush}" />
                      <Border Height="6" Width="56" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource SubBrush}" />
                      <Border Height="6" Width="46" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource SubBrush}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="{DynamicResource R6}">
                    <StackPanel Margin="8" Spacing="6">
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource MutedBrush}" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.8" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource SubBrush}" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource SubBrush}" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource SubBrush}" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource SubBrush}" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource SubBrush}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <StackPanel Spacing="4">
                <TextBlock Text="{ui:T 'Классический'}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{ui:T 'Плотная таблица треков, дерево медиатеки и панель со временем, как в настольных плеерах.'}"
                           Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Button>
        </WrapPanel>
      </StackPanel>
      </ScrollViewer>
    </Border>
  </Panel>
  </LayoutTransformControl>
  </Panel>
</Window>
