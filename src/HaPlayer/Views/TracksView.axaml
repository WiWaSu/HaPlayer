<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HaPlayer.ViewModels"
             xmlns:v="using:HaPlayer.Views"
             xmlns:ui="using:HaPlayer.Ui"
             x:Class="HaPlayer.Views.TracksView"
             x:DataType="vm:TracksPageViewModel">
  <Panel>
    <v:EmptyView IsVisible="{Binding !HasMusic}" />

    <!-- Список виртуализирован, поэтому шапка стоит над ним, а прокручивается только список. -->
    <DockPanel IsVisible="{Binding HasMusic}">
      <Border DockPanel.Dock="Top" Background="{Binding HeaderBrush}" Padding="24,40,24,20">
        <StackPanel Orientation="Horizontal" Spacing="24">
          <Border Width="152" Height="152" CornerRadius="4" BoxShadow="0 4 60 0 #80000000"
                  Background="{DynamicResource LibraryArtBrush}">
            <ui:Glyph Data="{x:Static ui:Icons.Library}" Width="64" Height="64" Foreground="White" />
          </Border>
          <StackPanel VerticalAlignment="Bottom">
            <TextBlock Text="Медиатека" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="Все треки" Classes="hero" />
            <TextBlock Text="{Binding Summary}" FontSize="14" Foreground="#C0FFFFFF" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="20" Margin="24,20,24,16">
        <Button Classes="primary" Command="{Binding PlayAllCommand}" ToolTip.Tip="Играть все">
          <ui:Glyph Data="{x:Static ui:Icons.Play}" Width="28" Height="28" />
        </Button>
        <Button Classes="icon large" Command="{Binding ShufflePlayCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Играть в случайном порядке">
          <ui:Glyph Data="{x:Static ui:Icons.Shuffle}" Width="28" Height="28" />
        </Button>
      </StackPanel>

      <Border DockPanel.Dock="Top" Margin="24,0" BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,0,0,1" Padding="0,0,0,8">
        <Grid ColumnDefinitions="40,5*,3*,120,120">
          <TextBlock Text="#" Classes="sub" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="1" Text="Название" Classes="sub" Margin="16,0,0,0" />
          <TextBlock Grid.Column="2" Text="Альбом" Classes="sub" />
          <TextBlock Grid.Column="3" Text="Дата добавления" Classes="sub" />
          <ui:Glyph Grid.Column="4" Data="{x:Static ui:Icons.Clock}" Width="16" Height="16"
                    Foreground="{StaticResource SubBrush}" HorizontalAlignment="Right" Margin="0,0,24,0" />
        </Grid>
      </Border>

      <ListBox x:Name="Rows" Classes="plain tracks" Margin="24,8,24,8" SelectionMode="Multiple"
               ItemsSource="{Binding Rows}"
               ItemTemplate="{StaticResource TrackRowTemplate}" />
    </DockPanel>
  </Panel>
</UserControl>
