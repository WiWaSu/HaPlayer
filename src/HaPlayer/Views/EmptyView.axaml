<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HaPlayer.ViewModels"
             xmlns:ui="using:HaPlayer.Ui"
             x:Class="HaPlayer.Views.EmptyView"
             x:DataType="vm:PageViewModel"
             Background="{DynamicResource GlowBrush}">
  
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
    <Border Width="96" Height="96" CornerRadius="48" Background="{StaticResource ElevatedBrush}"
            HorizontalAlignment="Center" Margin="0,0,0,8">
      <ui:Glyph Data="{x:Static ui:Icons.Note}" Width="44" Height="44" Foreground="{DynamicResource AccentBrush}" />
    </Border>
    <TextBlock Text="Здесь пока тихо" FontSize="28" FontWeight="ExtraBold" HorizontalAlignment="Center" />
    <TextBlock Text="Добавьте папку с музыкой или перетащите файлы прямо в окно." Classes="sub"
               FontSize="14" HorizontalAlignment="Center" />
    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,12,0,0">
      <Button Classes="pill" Content="Выбрать папку" Command="{Binding AddFolderCommand}" />
      <Button Classes="pill ghost" Content="Выбрать файлы" Command="{Binding AddFilesCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
