<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HaPlayer.ViewModels"
             xmlns:ui="using:HaPlayer.Ui"
             x:Class="HaPlayer.Views.CollectionView"
             x:DataType="vm:CollectionPageViewModel">
  <!-- Одна страница для альбома, исполнителя и плейлиста -->
  <ScrollViewer>
    <StackPanel>
      <Border Classes="pagehead" Background="{Binding HeaderBrush}">
        <Grid ColumnDefinitions="Auto,*">
          <ui:CoverView Classes="herocover" Source="{Binding Item.Art}" CornerRadius="{Binding CoverRadius}"
                        IsLiked="{Binding Item.IsLikedCollection}"
                        BoxShadow="0 4 60 0 #80000000" />
          <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding KindLabel}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Item.Name}" Classes="hero" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Owner}" FontSize="14" FontWeight="Bold" />
              <TextBlock Text="{Binding Meta}" FontSize="14" FontWeight="Medium" Foreground="#E6FFFFFF" />
            </StackPanel>
            <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="13" FontStyle="Italic"
                       Foreground="#CCFFFFFF" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Background="{Binding ContentBrush}" Padding="24,20,24,24" MinHeight="400">
        <StackPanel>
          <!-- Как у Spotify: большая «играть», «перемешать» и «…» с остальными действиями -->
          <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,24">
            <Button Classes="primary" Command="{Binding PlayCommand}" IsEnabled="{Binding HasTracks}" ToolTip.Tip="{ui:T 'Играть'}">
              <ui:Glyph Data="{x:Static ui:Icons.Play}" Width="28" Height="28" />
            </Button>
            <Button Classes="icon large" Command="{Binding ShufflePlayCommand}" IsEnabled="{Binding HasTracks}"
                    VerticalAlignment="Center" ToolTip.Tip="{ui:T 'Играть в случайном порядке'}">
              <ui:Glyph Data="{x:Static ui:Icons.Shuffle}" Width="28" Height="28" />
            </Button>
            <Button Classes="icon large" Command="{Binding QueueCommand}" IsEnabled="{Binding HasTracks}"
                    VerticalAlignment="Center" ToolTip.Tip="{ui:T 'В очередь'}">
              <ui:Glyph Data="{x:Static ui:Icons.Queue}" Width="26" Height="26" />
            </Button>
            <Button Classes="icon large" Command="{Binding LikeAllCommand}" IsVisible="{Binding CanLikeAll}"
                    VerticalAlignment="Center" ToolTip.Tip="{ui:T 'Все треки в любимые'}">
              <Panel Width="28" Height="28">
                <ui:Glyph Data="{x:Static ui:Icons.CirclePlus}" IsVisible="{Binding !AllLiked}" />
                <Panel IsVisible="{Binding AllLiked}">
                  <ui:Glyph Data="{x:Static ui:Icons.CircleFill}" Foreground="{DynamicResource AccentBrush}" />
                  <ui:Glyph Data="{x:Static ui:Icons.Check}" Foreground="Black" StrokeThickness="3" />
                </Panel>
              </Panel>
            </Button>
            <Button x:Name="MoreButton" Classes="icon large" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding MoreTip}">
              <ui:Glyph Data="{x:Static ui:Icons.More}" Width="30" Height="30" />
            </Button>
          </StackPanel>

          <!-- Тёмные таблетки под кнопками, как «+ Добавить» и «Название и сведения» у Spotify -->
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,-8,0,24">
            <Button Classes="pill dark" Command="{Binding AddSongsCommand}" IsVisible="{Binding CanAddSongs}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:Glyph Data="{x:Static ui:Icons.Add}" Width="16" Height="16" />
                <TextBlock Text="{ui:T 'Добавить'}" />
              </StackPanel>
            </Button>
            <Button Classes="pill dark" Command="{Binding RenameCommand}" IsVisible="{Binding IsPlaylist}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:Glyph Data="{x:Static ui:Icons.Edit}" Width="16" Height="16" />
                <TextBlock Text="{ui:T 'Название'}" />
              </StackPanel>
            </Button>
            <Button Classes="pill dark" Command="{Binding ChangePhotoCommand}" IsVisible="{Binding CanChangePhoto}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:Glyph Data="{x:Static ui:Icons.Photo}" Width="16" Height="16" />
                <TextBlock Text="{ui:T 'Обложка'}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Text="{Binding EmptyText}" Classes="sub" FontSize="14" TextWrapping="Wrap" MaxWidth="520"
                     HorizontalAlignment="Left" IsVisible="{Binding !HasTracks}" />

          <!-- Страница исполнителя: вкладки «Альбомы», «Треки», «Появляется в» -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,20" IsVisible="{Binding IsArtist}">
            <Button Classes="chip" Classes.active="{Binding ShowOwnAlbums}" Content="{ui:T 'Альбомы'}"
                    Command="{Binding SelectArtistTabCommand}" CommandParameter="0" IsVisible="{Binding HasArtistAlbums}" />
            <Button Classes="chip" Classes.active="{Binding ShowTrackList}" Content="{ui:T 'Треки'}"
                    Command="{Binding SelectArtistTabCommand}" CommandParameter="1" />
            <Button Classes="chip" Classes.active="{Binding ShowAppearsOn}" Content="{ui:T 'Появляется в'}"
                    Command="{Binding SelectArtistTabCommand}" CommandParameter="2" IsVisible="{Binding HasAppearsOn}" />
          </StackPanel>

          <!-- Страница папки: вложенные папки -->
          <ItemsControl ItemsSource="{Binding SubFolders}" Margin="-12,0,0,24" IsVisible="{Binding HasSubFolders}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderItem">
                <Button Classes="card" Command="{Binding OpenCommand}">
                  <StackPanel Spacing="4">
                    <Panel Margin="0,0,0,8">
                      <ui:CoverView Classes="cardcover" CornerRadius="{DynamicResource R6}" Source="{Binding Art}" Badge="{Binding Badge}" />
                      <Border Background="#99000000" CornerRadius="{DynamicResource R4}" Padding="6,4" Margin="8"
                              HorizontalAlignment="Left" VerticalAlignment="Top">
                        <ui:Glyph Data="{x:Static ui:Icons.Folder}" Width="14" Height="14" Foreground="White" />
                      </Border>
                    </Panel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="{Binding CardSubtitle}" Classes="sub" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Spacing="12" Margin="0,0,0,28">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding Path="ShowOwnAlbums" />
                <Binding Path="ShowAppearsOn" />
              </MultiBinding>
            </StackPanel.IsVisible>
            <ItemsControl ItemsSource="{Binding TabAlbums}" Margin="-12,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AlbumItem">
                  <Button Classes="card" Command="{Binding OpenCommand}">
                    <StackPanel Spacing="4">
                      <Panel Margin="0,0,0,8">
                        <ui:CoverView Classes="cardcover" CornerRadius="{DynamicResource R6}" Source="{Binding Art}"
                                      BoxShadow="0 8 24 0 #80000000" />
                        <Button Classes="primary small float" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Width="48" Height="48" CornerRadius="24" Margin="0,0,8,8"
                                Command="{Binding PlayCommand}">
                          <ui:Glyph Data="{x:Static ui:Icons.Play}" Width="24" Height="24" />
                        </Button>
                      </Panel>
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" />
                      <TextBlock Text="{Binding CardSubtitle}" Classes="sub" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel IsVisible="{Binding ShowTrackList}">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8"
                    Margin="0,0,0,8">
              <Grid ColumnDefinitions="40,5*,3*,120,120">
                <TextBlock Text="#" Classes="sub" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="1" Text="{ui:T 'Название'}" Classes="sub coltitle" Margin="16,0,0,0" />
                <TextBlock Grid.Column="2" Text="{ui:T 'Альбом'}" Classes="sub colalbum" Classes.noalbum="{Binding !ShowAlbumColumn}" />
                <TextBlock Grid.Column="3" Text="{ui:T 'Дата добавления'}" Classes="sub coldate" />
                <ui:Glyph Grid.Column="4" Data="{x:Static ui:Icons.Clock}" Width="16" Height="16"
                          Foreground="{DynamicResource SubBrush}" HorizontalAlignment="Right" Margin="0,0,24,0" />
              </Grid>
            </Border>

            <ListBox x:Name="Rows" Classes="plain tracks" SelectionMode="Multiple" ItemsSource="{Binding Rows}"
                     ItemTemplate="{StaticResource TrackRowTemplate}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
