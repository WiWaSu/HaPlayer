<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HaPlayer.ViewModels"
             xmlns:ui="using:HaPlayer.Ui"
             x:Class="HaPlayer.Views.SettingsView"
             x:DataType="vm:SettingsPageViewModel">
  <UserControl.Styles>
    <Style Selector="StackPanel.group">
      <Setter Property="Spacing" Value="14" />
      <Setter Property="Margin" Value="0,0,0,36" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="Border.option">
      <Setter Property="Background" Value="{DynamicResource Ov0D}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.option.current">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Категории слева -->
    <Style Selector="Button.cat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SubBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.cat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Ov1A}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.cat.active">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="Button.swatch">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Width" Value="118" />
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Ov14}" />
    </Style>
    <Style Selector="Button.swatch.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.swatch.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Строка внизу вместо большого логотипа -->
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding FooterText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
               Margin="32,8,32,16" />

    <Grid ColumnDefinitions="220,*">
      <!-- Категории -->
      <StackPanel Margin="20,32,8,0" Spacing="2">
        <TextBlock Text="{ui:T 'Настройки'}" FontSize="28" FontWeight="ExtraBold" Margin="14,0,0,18" />
        <Button Classes="cat" Classes.active="{Binding IsLibraryCat}" Content="{ui:T 'Медиатека'}"
                Command="{Binding SelectCategoryCommand}" CommandParameter="library" />
        <Button Classes="cat" Classes.active="{Binding IsSoundCat}" Content="{ui:T 'Звук'}"
                Command="{Binding SelectCategoryCommand}" CommandParameter="sound" />
        <Button Classes="cat" Classes.active="{Binding IsLookCat}" Content="{ui:T 'Оформление'}"
                Command="{Binding SelectCategoryCommand}" CommandParameter="look" />
        <Button Classes="cat" Classes.active="{Binding IsDownloadsCat}" Content="{ui:T 'Загрузки'}"
                Command="{Binding SelectCategoryCommand}" CommandParameter="downloads" />
        <Button Classes="cat" Classes.active="{Binding IsDataCat}" Content="{ui:T 'Данные'}"
                Command="{Binding SelectCategoryCommand}" CommandParameter="data" />
        <Button Classes="cat" Classes.active="{Binding IsKeysCat}" Content="{ui:T 'Клавиши'}"
                Command="{Binding SelectCategoryCommand}" CommandParameter="keys" />
        <Button Classes="cat" Classes.active="{Binding IsAppCat}" Content="{ui:T 'Программа'}"
                Command="{Binding SelectCategoryCommand}" CommandParameter="app" />
      </StackPanel>

      <ScrollViewer Grid.Column="1">
        <StackPanel Margin="24,40,32,24" MaxWidth="760" HorizontalAlignment="Left">

          <!-- ===== Медиатека ===== -->
          <StackPanel IsVisible="{Binding IsLibraryCat}">
            <StackPanel Classes="group">
              <TextBlock Text="{ui:T 'Папки с музыкой'}" Classes="title" />
              <TextBlock Text="{Binding LibrarySummary}" Classes="sub" />
              <TextBlock Text="{ui:T 'Папок нет'}" Classes="sub" IsVisible="{Binding HasNoFolders}" />
              <ItemsControl ItemsSource="{Binding Folders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FolderRow">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4">
                      <ui:Glyph Data="{x:Static ui:Icons.Folder}" Width="20" Height="20" Foreground="{DynamicResource SubBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Path}" Classes="label" Margin="12,0" />
                      <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#FF6B6B" FontSize="12"
                                 VerticalAlignment="Center" Margin="0,0,12,0" />
                      <Button Grid.Column="3" Classes="pill dark" Content="{ui:T 'Убрать'}" Padding="14,6"
                              Command="{Binding RemoveCommand}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel>
                <Button Classes="pill" Command="{Binding AddFolderCommand2}" Margin="0,0,10,10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:Glyph Data="{x:Static ui:Icons.Folder}" Width="16" Height="16" />
                    <TextBlock Text="{ui:T 'Добавить папку'}" />
                  </StackPanel>
                </Button>
                <Button Classes="pill dark" Command="{Binding Main.AddFilesCommand}" Margin="0,0,10,10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:Glyph Data="{x:Static ui:Icons.Add}" Width="16" Height="16" />
                    <TextBlock Text="{ui:T 'Файлы'}" />
                  </StackPanel>
                </Button>
                <Button Classes="pill dark" Command="{Binding AddArtistFolderCommand}" Margin="0,0,10,10"
                        ToolTip.Tip="{ui:T 'Все песни из папки дискографии попадут к одному исполнителю, даже если в тегах написано по-разному. Файлы не меняются.'}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:Glyph Data="{x:Static ui:Icons.Person}" Width="16" Height="16" />
                    <TextBlock Text="{ui:T 'Папка дискографии'}" />
                  </StackPanel>
                </Button>
                <Button Classes="pill dark" Content="{ui:T 'Проверить сейчас'}" Command="{Binding RescanCommand}" Margin="0,0,10,10" />
              </WrapPanel>
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Проверять папки при запуске'}" Classes="label" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding RescanOnStart}" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Альбом и исполнитель только из тегов'}" Classes="label" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding StrictTags}" VerticalAlignment="Center"
                              ToolTip.Tip="{ui:T 'Перенос треков в другой альбом и смена исполнителя отключаются'}" />
              </Grid>
            </StackPanel>

            <StackPanel Classes="group">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Импорт плейлистов'}" Classes="title" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="pill" VerticalAlignment="Center" Command="{Binding ImportPlaylistsCommand}"
                        ToolTip.Tip="Winamp, AIMP, VLC, Windows Media Player, iTunes">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:Glyph Data="{x:Static ui:Icons.Import}" Width="16" Height="16" />
                    <TextBlock Text="{ui:T 'Импортировать'}" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel Classes="group">
              <TextBlock Text="{ui:T 'Форматы'}" Classes="title" />
              <ItemsControl ItemsSource="{Binding Formats}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FormatOption">
                    <CheckBox IsChecked="{Binding IsEnabled}" Margin="0,4" ToolTip.Tip="{Binding Description}">
                      <TextBlock Text="{Binding Name}" FontSize="15" />
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <!-- ===== Звук ===== -->
          <StackPanel IsVisible="{Binding IsSoundCat}">
            <StackPanel Classes="group">
              <TextBlock Text="{ui:T 'Звук'}" Classes="title" />
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Устройство'}" Classes="label" />
                <Button Grid.Column="1" Classes="pill dark" Command="{Binding Main.ToggleDevicesPanelCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:Glyph Data="{x:Static ui:Icons.Devices}" Width="16" Height="16" />
                    <TextBlock Text="{ui:T 'Выбрать'}" />
                  </StackPanel>
                </Button>
              </Grid>
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Способ вывода'}" Classes="label" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}"
                          MinWidth="300" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{ui:T 'Буфер'}" Classes="label" ToolTip.Tip="{ui:T 'Если звук заикается, увеличьте.'}" />
                <Slider Grid.Column="1" Width="220" Minimum="30" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True"
                        Value="{Binding Latency}" />
                <TextBlock Grid.Column="2" Text="{Binding LatencyText}" Classes="label" Width="64" TextAlignment="Right" />
              </Grid>
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Эквалайзер'}" Classes="label" />
                <Button Grid.Column="1" Classes="pill dark" Content="{ui:T 'Открыть'}" Command="{Binding Main.ToggleEqualizerCommand}" />
              </Grid>
            </StackPanel>
          </StackPanel>

          <!-- ===== Оформление ===== -->
          <StackPanel IsVisible="{Binding IsLookCat}">
            <StackPanel Classes="group">
              <TextBlock Text="{ui:T 'Палитра'}" Classes="title" />
              <ItemsControl ItemsSource="{Binding Palettes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceOption">
                    <Button Classes="swatch" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                      <StackPanel Spacing="8">
                        <Panel HorizontalAlignment="Left">
                          <Ellipse Width="40" Height="40" Fill="{Binding Swatch}" />
                          <Ellipse Width="14" Height="14" Fill="{Binding Swatch2}" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" Margin="0,0,-4,-2" Stroke="{DynamicResource InputBrush}" StrokeThickness="2" />
                        </Panel>
                        <TextBlock Text="{Binding Name}" FontSize="13" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Classes="group">
              <TextBlock Text="{ui:T 'Свой цвет'}" Classes="title" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Ellipse Width="40" Height="40" Fill="{Binding CustomPreview}" VerticalAlignment="Center" />
                <TextBox Classes="inline" Width="140" Watermark="#FF2BD6" Text="{Binding CustomAccentText}"
                         VerticalAlignment="Center" />
                <Button Classes="pill" Content="{ui:T 'Применить'}" Command="{Binding ApplyCustomAccentCommand}"
                        IsEnabled="{Binding CustomValid}" VerticalAlignment="Center" />
                <Button Classes="pill dark" Content="{ui:T 'Цвет палитры'}" Command="{Binding ResetCustomAccentCommand}"
                        IsVisible="{Binding HasCustomAccent}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <StackPanel Classes="group">
              <TextBlock Text="{ui:T 'Фон'}" Classes="title" />
              <ItemsControl ItemsSource="{Binding Surfaces}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceOption">
                    <Button Classes="swatch" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                      <StackPanel Spacing="8">
                        <Border Width="64" Height="40" CornerRadius="6" Background="{Binding Swatch2}" HorizontalAlignment="Left"
                                BorderBrush="{DynamicResource Ov33}" BorderThickness="1">
                          <Border Width="40" Height="24" CornerRadius="4" Background="{Binding Swatch}" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="13" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Цвет шапки по обложке'}" Classes="label" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding HeaderFromCover}" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
            <StackPanel Classes="group">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Язык'}" Classes="title" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedIndex="{Binding LanguageIndex}"
                          MinWidth="140" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Масштаб'}" Classes="label" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ScaleOptions}" SelectedIndex="{Binding ScaleIndex}"
                          MinWidth="140" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Шрифт'}" Classes="label" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding FontOptions}" SelectedIndex="{Binding FontIndex}"
                          MinWidth="140" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
            <StackPanel Classes="group">
              <TextBlock Text="{ui:T 'Список треков'}" Classes="title" />
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Компактный'}" Classes="label" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CompactList}" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Формат, частота, битрейт'}" Classes="label" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowTechInfo}" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Сколько раз слушал'}" Classes="label" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowPlayCount}" VerticalAlignment="Center"
                              ToolTip.Tip="{ui:T 'Считается по истории прослушивания'}" />
              </Grid>
            </StackPanel>
          </StackPanel>

          <!-- ===== Загрузки ===== -->
          <StackPanel IsVisible="{Binding IsDownloadsCat}">
            <StackPanel Classes="group">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'По ссылке'}" Classes="title" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="pill" VerticalAlignment="Center" Command="{Binding DownloadByLinkCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:Glyph Data="{x:Static ui:Icons.Import}" Width="16" Height="16" />
                    <TextBlock Text="{ui:T 'Вставить ссылку'}" />
                  </StackPanel>
                </Button>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ui:Glyph Data="{x:Static ui:Icons.Folder}" Width="20" Height="20" Foreground="{DynamicResource SubBrush}" />
                <StackPanel Grid.Column="1" Margin="12,0">
                  <TextBlock Text="{ui:T 'Куда сохранять'}" Classes="label" />
                  <TextBlock Text="{Binding DownloadFolder}" Classes="sub" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="pill dark" Content="{ui:T 'По умолчанию'}" Padding="14,6"
                          IsVisible="{Binding IsCustomDownloadFolder}" Command="{Binding ResetDownloadFolderCommand}" />
                  <Button Classes="pill dark" Content="{ui:T 'Изменить'}" Padding="14,6"
                          Command="{Binding ChangeDownloadFolderCommand}" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <StackPanel Classes="group">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Торренты'}" Classes="title" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Main.Torrents.IsEnabled}" VerticalAlignment="Center"
                              ToolTip.Tip="{ui:T 'Пока включено, ваш IP-адрес видят участники раздачи'}" />
              </Grid>
              <WrapPanel IsVisible="{Binding Main.Torrents.IsEnabled}">
                <Button Classes="pill" Command="{Binding Main.Torrents.AddMagnetCommand}" Margin="0,0,10,10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:Glyph Data="{x:Static ui:Icons.Import}" Width="16" Height="16" />
                    <TextBlock Text="{ui:T 'Magnet-ссылка'}" />
                  </StackPanel>
                </Button>
                <Button Classes="pill dark" Content="{ui:T '.torrent-файл'}" Command="{Binding Main.Torrents.AddTorrentFileCommand}" Margin="0,0,10,10" />
                <Button Classes="pill dark" Command="{Binding Main.Torrents.ShareFolderCommand}" Margin="0,0,10,10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:Glyph Data="{x:Static ui:Icons.Folder}" Width="16" Height="16" />
                    <TextBlock Text="{ui:T 'Раздать папку'}" />
                  </StackPanel>
                </Button>
              </WrapPanel>
              <ItemsControl ItemsSource="{Binding Main.Torrents.Rows}" IsVisible="{Binding Main.Torrents.IsEnabled}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TorrentRow">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,6">
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Classes="label" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" MinHeight="4"
                                     IsVisible="{Binding !IsDone}" />
                        <TextBlock Text="{Binding Status}" Classes="sub" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="pill dark" Content="{Binding CopyText}" Padding="14,6" Margin="12,0,0,0"
                              VerticalAlignment="Center" Command="{Binding CopyMagnetCommand}" />
                      <Button Grid.Column="2" Classes="pill dark" Content="{ui:T 'Папка'}" Padding="14,6" Margin="8,0,0,0"
                              VerticalAlignment="Center" Command="{Binding OpenFolderCommand}" />
                      <Button Grid.Column="3" Classes="pill dark" Content="{ui:T 'Убрать'}" Padding="14,6" Margin="8,0,0,0"
                              VerticalAlignment="Center" Command="{Binding RemoveCommand}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <!-- ===== Данные ===== -->
          <StackPanel IsVisible="{Binding IsDataCat}">
            <StackPanel Classes="group">
              <TextBlock Text="{ui:T 'Где хранить медиатеку и настройки'}" Classes="title" />
              <ItemsControl ItemsSource="{Binding DataModes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DataModeOption">
                    <Border Classes="option" Classes.current="{Binding IsCurrent}" Margin="0,0,0,8"
                            ToolTip.Tip="{Binding Description}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <Button Grid.Column="1" Classes="pill dark" Content="{Binding ButtonText}" VerticalAlignment="Center"
                                IsEnabled="{Binding !IsCurrent}" Command="{Binding SelectCommand}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto">
                <SelectableTextBlock Text="{Binding DataFolder}" FontSize="13" Foreground="{DynamicResource SubBrush}"
                                     VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="pill dark" Content="{ui:T 'Открыть папку'}" Command="{Binding OpenDataFolderCommand}" />
              </Grid>
            </StackPanel>
            <StackPanel Classes="group">
              <TextBlock Text="{ui:T 'История'}" Classes="title" />
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Вести историю прослушивания'}" Classes="label" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepHistory}" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </StackPanel>

          <!-- ===== Программа ===== -->
          <StackPanel IsVisible="{Binding IsAppCat}">
            <StackPanel Classes="group">
              <TextBlock Text="{ui:T 'Окно'}" Classes="title" />
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Крестик сворачивает в трей'}" Classes="label" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray}" VerticalAlignment="Center"
                              ToolTip.Tip="{ui:T 'Выход: правый клик по значку в трее'}" />
              </Grid>
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Открывать с прежней очередью'}" Classes="label" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding RestoreQueue}" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
            <StackPanel Classes="group" IsVisible="{Binding HasRepo}">
              <TextBlock Text="{ui:T 'Обновления'}" Classes="title" />
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Проверять при запуске'}" Classes="label" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckUpdates}" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="pill dark" Content="{ui:T 'Проверить сейчас'}" Command="{Binding CheckUpdatesNowCommand}" />
                <Button Classes="pill" IsVisible="{Binding Main.HasUpdate}" Command="{Binding Main.InstallUpdateCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:Glyph Data="{x:Static ui:Icons.Import}" Width="16" Height="16" />
                    <TextBlock Text="{ui:T 'Обновить'}" />
                  </StackPanel>
                </Button>
                <TextBlock Text="{Binding UpdateStatus}" Classes="sub" VerticalAlignment="Center" />
              </StackPanel>
              <Button Classes="pill dark" HorizontalAlignment="Left" Command="{Binding OpenGitHubCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ui:Glyph Data="{x:Static ui:Icons.GitHub}" Width="16" Height="16" />
                  <TextBlock Text="{ui:T 'HaPlayer на GitHub'}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>

          <!-- ===== Клавиши ===== -->
          <StackPanel IsVisible="{Binding IsKeysCat}">
            <StackPanel Classes="group">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{ui:T 'Клавиши при свёрнутом окне'}" Classes="title" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding GlobalHotkeys}" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{Binding GlobalHotkeyRows}" IsVisible="{Binding GlobalHotkeys}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HotkeyRow">
                    <Grid ColumnDefinitions="140,*" Margin="0,4">
                      <Border Background="{DynamicResource Ov1F}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Keys}" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Action}" Classes="label" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Classes="group">
              <TextBlock Text="{ui:T 'Горячие клавиши'}" Classes="title" />
              <ItemsControl ItemsSource="{Binding Hotkeys}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HotkeyRow">
                    <Grid ColumnDefinitions="140,*" Margin="0,4">
                      <Border Background="{DynamicResource Ov1F}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Keys}" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Action}" Classes="label" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
