<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HaPlayer.ViewModels"
             xmlns:ui="using:HaPlayer.Ui"
             x:Class="HaPlayer.Views.QueuePanelView"
             x:DataType="vm:MainViewModel">
  <!-- Правая панель «Сейчас играет», как у Spotify -->
  <Border Classes="panel">
    <ScrollViewer>
      <StackPanel Margin="16" Spacing="16">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Player.QueueTitle}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="icon hoverbg" Command="{Binding ToggleQueuePanelCommand}" ToolTip.Tip="{ui:T 'Закрыть'}">
            <ui:Glyph Data="{x:Static ui:Icons.Close}" Width="16" Height="16" />
          </Button>
        </Grid>

        <Viewbox Stretch="Uniform" StretchDirection="Both">
          <ui:CoverView Width="320" Height="320" CornerRadius="{DynamicResource R8}" Source="{Binding Player.CurrentTrack.Album.Art}" />
        </Viewbox>

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <Button Classes="flat" Command="{Binding OpenCurrentAlbumCommand}" HorizontalAlignment="Left">
              <TextBlock Classes="link" Text="{Binding Player.CurrentTrack.Title}" FontSize="24" FontWeight="Bold"
                         LetterSpacing="-0.4" />
            </Button>
            <Button Classes="flat" Command="{Binding OpenCurrentArtistCommand}" HorizontalAlignment="Left">
              <TextBlock Classes="link" Text="{Binding Player.CurrentTrack.Artist}" FontSize="15"
                         Foreground="{DynamicResource SubBrush}" />
            </Button>
            <TextBlock Text="{Binding Player.CurrentTrack.TechText}" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding ShowTechInfo}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="icon" Command="{Binding Player.ToggleLikeCommand}" VerticalAlignment="Center"
                  ToolTip.Tip="{ui:T 'Любимые треки (L)'}">
            <Panel Width="22" Height="22">
              <ui:Glyph Data="{x:Static ui:Icons.CirclePlus}" IsVisible="{Binding !Player.CurrentTrack.IsLiked}" />
              <Panel IsVisible="{Binding Player.CurrentTrack.IsLiked}">
                <ui:Glyph Data="{x:Static ui:Icons.CircleFill}" Foreground="{DynamicResource AccentBrush}" />
                <ui:Glyph Data="{x:Static ui:Icons.Check}" Foreground="Black" StrokeThickness="3" />
              </Panel>
            </Panel>
          </Button>
        </Grid>

        <!-- Далее в очереди -->
        <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="{DynamicResource R8}" Padding="12,14">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{ui:T 'Далее в очереди'}" FontSize="16" FontWeight="Bold" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button Classes="icon" Command="{Binding SaveQueueAsPlaylistCommand}" ToolTip.Tip="{ui:T 'Сохранить очередь как плейлист'}">
                  <ui:Glyph Data="{x:Static ui:Icons.PlaylistAdd}" Width="16" Height="16" />
                </Button>
                <Button Classes="icon" Command="{Binding ClearQueueCommand}" ToolTip.Tip="{ui:T 'Очистить очередь'}"
                        IsEnabled="{Binding !IsQueueEnd}">
                  <ui:Glyph Data="{x:Static ui:Icons.Delete}" Width="16" Height="16" />
                </Button>
                <Button Classes="flat" Command="{Binding ToggleNowPlayingCommand}" Margin="6,0,0,0">
                  <TextBlock Classes="link" Text="{ui:T 'Открыть'}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource SubBrush}" />
                </Button>
              </StackPanel>
            </Grid>
            <ItemsControl x:Name="UpNextList" ItemsSource="{Binding UpNextShort}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UpNextItem">
                  <Button Classes="row upnext" Command="{Binding PlayCommand}">
                    <Grid ColumnDefinitions="44,*,Auto">
                      <ui:CoverView Width="44" Height="44" Source="{Binding Track.Album.Thumb}" />
                      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Track.Title}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{Binding Track.Artist}" Classes="sub" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="icon rowx" Command="{Binding RemoveCommand}" ToolTip.Tip="{ui:T 'Убрать из очереди'}">
                        <ui:Glyph Data="{x:Static ui:Icons.Close}" Width="14" Height="14" />
                      </Button>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
