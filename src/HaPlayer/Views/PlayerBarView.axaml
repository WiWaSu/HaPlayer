<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HaPlayer.ViewModels"
             xmlns:ui="using:HaPlayer.Ui"
             x:Class="HaPlayer.Views.PlayerBarView"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="3*,4*,3*" Margin="8,0">

    <!-- Сейчас играет: нажатие на обложку или название разворачивает экран «Сейчас играет» -->
    <Grid ColumnDefinitions="Auto,Auto" VerticalAlignment="Center" HorizontalAlignment="Left"
          IsVisible="{Binding Player.HasTrack}">
      <Button Classes="flat" Command="{Binding ToggleNowPlayingCommand}" ToolTip.Tip="Развернуть">
        <Grid ColumnDefinitions="56,*">
          <ui:CoverView Width="56" Height="56" Source="{Binding Player.CurrentTrack.Album.Thumb}" />
          <StackPanel Grid.Column="1" Margin="14,0,4,0" VerticalAlignment="Center" Spacing="2" MaxWidth="260">
            <TextBlock Classes="link" Text="{Binding Player.CurrentTrack.Title}" FontSize="14" FontWeight="Medium" />
            <TextBlock Text="{Binding Player.CurrentTrack.Artist}" FontSize="12" Foreground="{StaticResource SubBrush}" />
          </StackPanel>
        </Grid>
      </Button>
      <Button Grid.Column="1" Classes="icon" Command="{Binding Player.ToggleLikeCommand}" Margin="8,0,0,0"
              ToolTip.Tip="Любимые треки (L)">
        <Panel Width="18" Height="18">
          <ui:Glyph Data="{x:Static ui:Icons.CirclePlus}" IsVisible="{Binding !Player.CurrentTrack.IsLiked}" />
          <Panel IsVisible="{Binding Player.CurrentTrack.IsLiked}">
            <ui:Glyph Data="{x:Static ui:Icons.CircleFill}" Foreground="{DynamicResource AccentBrush}" />
            <ui:Glyph Data="{x:Static ui:Icons.Check}" Foreground="Black" StrokeThickness="3" />
          </Panel>
        </Panel>
      </Button>
    </Grid>

    <!-- Кнопки и прогресс -->
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" MaxWidth="720">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18">
        <Button Classes="icon dotted" Classes.on="{Binding Player.Shuffle}" Command="{Binding Player.ToggleShuffleCommand}"
                ToolTip.Tip="Случайный порядок (S)">
          <ui:Glyph Data="{x:Static ui:Icons.Shuffle}" Width="17" Height="17" />
        </Button>
        <Button Classes="icon" Command="{Binding Player.PreviousCommand}" ToolTip.Tip="Назад (Z)">
          <ui:Glyph Data="{x:Static ui:Icons.Prev}" Width="17" Height="17" />
        </Button>
        <Button Classes="play" Command="{Binding Player.PlayPauseCommand}" ToolTip.Tip="Играть / пауза (пробел)">
          <ui:Glyph Data="{Binding Player.PlayIcon}" Width="17" Height="17" />
        </Button>
        <Button Classes="icon" Command="{Binding Player.NextCommand}" ToolTip.Tip="Далее (B)">
          <ui:Glyph Data="{x:Static ui:Icons.Next}" Width="17" Height="17" />
        </Button>
        <Button Classes="icon dotted" Classes.on="{Binding Player.IsRepeatOn}" Command="{Binding Player.CycleRepeatCommand}"
                ToolTip.Tip="{Binding Player.RepeatTip}">
          <ui:Glyph Data="{Binding Player.RepeatIcon}" Width="17" Height="17" />
        </Button>
      </StackPanel>

      <Grid ColumnDefinitions="44,*,44">
        <TextBlock Text="{Binding Player.PositionText}" FontSize="12" Foreground="{StaticResource SubBrush}"
                   HorizontalAlignment="Right" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Margin="8,0" Minimum="0" Maximum="{Binding Player.SliderMaximum}"
                Value="{Binding Player.Position, Mode=TwoWay}" IsEnabled="{Binding Player.HasTrack}" />
        <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" FontSize="12"
                   Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" />
      </Grid>
    </StackPanel>

    <!-- Справа мелкие серые значки, как у Spotify -->
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                Spacing="6" Margin="0,0,8,0">
      <Button Classes="icon dotted" Classes.on="{Binding Equalizer.Enabled}" Command="{Binding ToggleEqualizerCommand}"
              ToolTip.Tip="Эквалайзер (E)">
        <ui:Glyph Data="{x:Static ui:Icons.Equalizer}" Width="17" Height="17" />
      </Button>
      <Button Classes="icon dotted" Classes.on="{Binding IsQueuePanelOpen}" Command="{Binding ToggleQueuePanelCommand}"
              ToolTip.Tip="Сейчас играет и очередь">
        <ui:Glyph Data="{x:Static ui:Icons.Queue}" Width="17" Height="17" />
      </Button>
      <Button Classes="icon dotted" Classes.on="{Binding IsDevicesPanelOpen}" Command="{Binding ToggleDevicesPanelCommand}"
              ToolTip.Tip="Устройства вывода">
        <ui:Glyph Data="{x:Static ui:Icons.Devices}" Width="17" Height="17" />
      </Button>
      <Button Classes="icon" Command="{Binding Player.ToggleMuteCommand}" ToolTip.Tip="Без звука">
        <ui:Glyph Data="{Binding Player.VolumeIcon}" Width="17" Height="17" />
      </Button>
      <Slider Width="96" Minimum="0" Maximum="100" Value="{Binding Player.Volume, Mode=TwoWay}" />
      <Button Classes="icon" Command="{Binding ToggleNowPlayingCommand}" ToolTip.Tip="Во весь экран"
              Margin="6,0,0,0">
        <ui:Glyph Data="{x:Static ui:Icons.Maximize}" Width="17" Height="17" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
